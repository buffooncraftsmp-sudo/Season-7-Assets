# the core itself: a glowing, never-despawning item resting on the plinth
summon item ~ ~2.1 ~ {PickupDelay:20,Age:-32768,Glowing:1b,Motion:[0.0,0.0,0.0],Item:{id:"minecraft:ochre_froglight",count:1,components:{"minecraft:custom_name":{text:"Astronomer's Stone of The Comet",color:"#FFB627",italic:false,bold:true},"minecraft:lore":[{text:"Gilded fragment of a wandering comet",color:"gray",italic:true},{text:"Place it in the world to complete the mission",color:"dark_gray",italic:false}],"minecraft:custom_data":{buffoon_stone:"comet"},"minecraft:enchantment_glint_override":true,"minecraft:rarity":"epic","minecraft:max_stack_size":1}}}
# beams now converge just above the core
tp @s ~ ~3.5 ~
particle minecraft:explosion_emitter ~ ~2 ~ 0 0 0 0 1 force @a
particle minecraft:totem_of_undying ~ ~3 ~ 1.5 1.5 1.5 0.6 400 force @a
particle minecraft:wax_on ~ ~3 ~ 2 2 2 0 200 force @a
playsound minecraft:entity.generic.explode master @a[distance=..300] ~ ~ ~ 8 0.5
playsound minecraft:block.end_portal.spawn master @a[distance=..300] ~ ~ ~ 100 1
playsound minecraft:ui.toast.challenge_complete master @a[distance=..300] ~ ~ ~ 100 1
title @a[distance=..300] title {text:"Comet Core Breached!",color:"gold",bold:true}
title @a[distance=..300] subtitle {text:"The Comet's Core has been revealed",color:"yellow"}
# put your own event logic in buffoon:lasers/on_complete
function buffoon:lasers/on_complete
advancement grant @a[distance=..300] until buffoon:s7/comet_core
