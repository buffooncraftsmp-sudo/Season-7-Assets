$execute if score #$(side) buffoon.twins matches 1 run return run tellraw @s {text:"$(name) is already alive.",color:"red"}
$execute if score #$(side) buffoon.twins matches 2 run return run tellraw @s {text:"$(name) has already been beaten - run /function buffoon:twins/reset {side:\"$(side)\"} first.",color:"red"}
$summon drowned ~ ~ ~ {Tags:["buffoon.twin_new_$(side)"],CustomName:{text:"$(name)",color:"$(color)",bold:true},Health:150f,equipment:{mainhand:{id:"minecraft:trident",count:1},head:{id:"minecraft:turtle_helmet",count:1}},drop_chances:{mainhand:0.0f,head:0.0f},attributes:[{id:"minecraft:max_health",base:150.0d},{id:"minecraft:attack_damage",base:10.0d},{id:"minecraft:armor",base:10.0d},{id:"minecraft:movement_speed",base:0.3d},{id:"minecraft:follow_range",base:40.0d},{id:"minecraft:knockback_resistance",base:0.6d},{id:"minecraft:scale",base:1.4d}]}
$execute as @n[type=drowned,tag=buffoon.twin_new_$(side)] at @s run function buffoon:twins/adopt with storage buffoon:twins sides.$(side)
