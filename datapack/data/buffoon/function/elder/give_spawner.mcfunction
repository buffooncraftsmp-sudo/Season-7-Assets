# Gives you the Coralline Elder's trial spawner. range = how close (in blocks) a player must get to wake it.
# Place it in open water with at least 3x3x3 of water around it - the Elder is big.
#   /function buffoon:elder/give_spawner {range:6}
$give @s minecraft:trial_spawner[custom_name={text:"Coralline Elder Spawner",color:"#3FD8E0",italic:false},block_entity_data={id:"minecraft:trial_spawner",required_player_range:$(range),target_cooldown_length:2000000000,normal_config:{spawn_range:2,total_mobs:1.0f,simultaneous_mobs:1.0f,total_mobs_added_per_player:0.0f,simultaneous_mobs_added_per_player:0.0f,ticks_between_spawn:20,loot_tables_to_eject:[{data:"buffoon:twins/nothing",weight:1}],items_to_drop_when_ominous:"buffoon:twins/nothing",spawn_potentials:[{weight:1,data:{entity:{id:"minecraft:elder_guardian",Tags:["buffoon.elder_new"],CustomName:{text:"The Coralline Elder",color:"#3FD8E0",bold:true},Health:240f,attributes:[{id:"minecraft:max_health",base:240.0d},{id:"minecraft:attack_damage",base:24.0d},{id:"minecraft:follow_range",base:32.0d}]}}}]},ominous_config:{spawn_range:2,total_mobs:1.0f,simultaneous_mobs:1.0f,total_mobs_added_per_player:0.0f,simultaneous_mobs_added_per_player:0.0f,ticks_between_spawn:20,loot_tables_to_eject:[{data:"buffoon:twins/nothing",weight:1}],items_to_drop_when_ominous:"buffoon:twins/nothing",spawn_potentials:[{weight:1,data:{entity:{id:"minecraft:elder_guardian",Tags:["buffoon.elder_new"],CustomName:{text:"The Coralline Elder",color:"#3FD8E0",bold:true},Health:240f,attributes:[{id:"minecraft:max_health",base:240.0d},{id:"minecraft:attack_damage",base:24.0d},{id:"minecraft:follow_range",base:32.0d}]}}}]}}]
$tellraw @s {text:"Coralline Elder Spawner given (wakes within $(range) blocks). Place it, then save Coralline while it's still fresh.",color:"#3FD8E0"}
